{
  "name": "vegapunk",
  "version": "0.1.4",
  "description": "AI-assisted exploratory testing on top of Playwright",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianahilario/vegapunk.git"
  },
  "homepage": "https://github.com/ianahilario/vegapunk#readme",
  "bugs": {
    "url": "https://github.com/ianahilario/vegapunk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./reporter": {
      "require": {
        "types": "./dist/report/reporter.d.cts",
        "default": "./dist/report/reporter.cjs"
      },
      "import": {
        "types": "./dist/report/reporter.d.ts",
        "default": "./dist/report/reporter.js"
      },
      "default": "./dist/report/reporter.js"
    }
  },
  "workspaces": [
    "examples/todomvc"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jiti src/duration.test.ts && jiti src/config/load.test.ts && jiti src/agent/route.test.ts && jiti src/agent/a11y.test.ts && jiti src/agent/allowed-origin.test.ts",
    "test:example": "npm --prefix examples/todomvc run ui",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.22",
    "@axe-core/playwright": "^4.13.0",
    "ai": "^4.3.16",
    "dotenv": "^16.5.0",
    "jiti": "^2.4.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
